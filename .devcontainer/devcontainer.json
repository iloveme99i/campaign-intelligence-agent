{
  "name": "Campaign Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [8101],
  "portsAttributes": {
    "8101": {
      "label": "Campaign Intelligence",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "pip install uv && uv sync --extra dev && corepack enable && cd frontend && pnpm install --frozen-lockfile && pnpm build",
  "postStartCommand": "nohup bash -lc 'CAMPAIGN_HOST=0.0.0.0 ./scripts/run-merchant-local.sh' >/tmp/campaign-intelligence.log 2>&1 &"
}
